{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:ui": "cross-env VITE_DEV_AUTH_BYPASS=true vite",
    "build": "cross-env CI=false vite build",
    "build:prod": "cross-env GENERATE_SOURCEMAP=false CI=false vite build",
    "test": "vitest",
    "preview": "vite preview",
    "serve": "vite preview",
    "lint": "eslint . --ext js,jsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.checkjs.json",
    "generate:module": "node scripts/generate-module.js",
    "verify:architecture": "node scripts/verify-architecture.js",
    "check:frontend-standard": "npm run lint && npm run verify:architecture && npm run build",
    "check:uat:env": "bash ./ops/check-uat-env.sh .env.uat",
    "check:uat:build": "cross-env CI=false vite build --mode uat",
    "check:uat:endpoint": "bash ./ops/check-uat-endpoint.sh .env.uat",
    "check:uat": "npm run check:uat:env && npm run check:uat:build && npm run check:uat:endpoint",
    "check:all": "npm run format:check && npm run lint && npm run verify:architecture && npm run typecheck && npm run test -- --run && npm run build",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@clerk/react": "^6.9.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@sentry/react": "^10.57.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.108.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.42.2",
    "pixi.js": "^8.19.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "msw": "2.15.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
