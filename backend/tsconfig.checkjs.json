{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "server.js",
    "instrument.js",
    "src/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js"
  ]
}
