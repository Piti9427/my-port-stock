{
  "name": "myportstock-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run start --workspace=backend",
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:ui": "concurrently \"npm run dev:ui --workspace=backend\" \"npm run dev:ui --workspace=frontend\"",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present",
    "test:e2e": "npx playwright test",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:format": "npm run format:check --workspaces --if-present",
    "check:lint": "npm run lint --workspaces --if-present",
    "check:type": "npm run typecheck --workspaces --if-present",
    "check:build": "npm run build --workspaces --if-present",
    "check:unit": "npm run test:unit --workspaces --if-present",
    "check:coverage": "npm run test --workspace=frontend -- --run --coverage",
    "check:python": "python3 tools/market_oracle_test.py",
    "check:e2e": "npx playwright test --config=frontend/playwright.config.ts",
    "check:pr": "node scripts/check-pr.js",
    "check:frontend-standard": "npm run check:frontend-standard --workspaces --if-present",
    "check:all": "node scripts/check-pr.js",
    "prepare": "npm run prepare --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3"
  }
}
